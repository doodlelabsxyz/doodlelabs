# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (server only)
DATABASE_URL=

# Public base URL of the app, used for links in emails
NEXT_PUBLIC_APP_URL=

# Comma-separated emails granted super admin access
SUPER_ADMIN_EMAILS=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Set to true on demo/staging deployments to keep them out of search engines
NEXT_PUBLIC_NOINDEX=
